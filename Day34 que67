#include<stdio.h>
int main()
{
int a[100],n,i,pos,num;
printf("enter size of array");
scanf("%d",&n);
printf("enter array element");
for(i=0;i<n;i++)
scanf("%d",&a[i]);
printf("enter element and position");
scanf("%d%d",&num,&pos);
for(i=n;i>=pos;i--)
a[i]=a[i-1];
a[pos-1]=num;
n++;
printf("updated array");
for(i=0;i<n;i++)
printf("%d",a[i]);
return 0;
}
